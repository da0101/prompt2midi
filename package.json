{
  "name": "prompt2midi",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Ableton/JUCE AI co-producer backend.",
  "type": "commonjs",
  "scripts": {
    "app:refresh": "bash scripts/rebuild-standalone.sh",
    "dev:refresh": "bash scripts/dev-refresh.sh",
    "setup:stems": "bash scripts/setup-stem-engine.sh",
    "setup:transcription": "bash scripts/setup-transcription-engine.sh",
    "setup:ace-step": "bash scripts/setup-ace-step-engine.sh",
    "ace-step:start": "bash scripts/start-ace-step-api.sh",
    "reference": "node scripts/run-reference-pipeline.js",
    "feedback": "node scripts/record-listen-feedback.js",
    "start": "node --env-file=.env backend/server.js",
    "test": "node --test backend/test/*.test.js",
    "setup:musicgen": "bash scripts/setup-musicgen-engine.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
