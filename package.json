{
  "name": "prompt2midi",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Ableton/JUCE AI co-producer backend.",
  "type": "commonjs",
  "scripts": {
    "app:refresh": "bash scripts/dev/rebuild-standalone.sh",
    "dev:refresh": "bash scripts/dev/dev-refresh.sh",
    "setup:stems": "bash scripts/setup/setup-stem-engine.sh",
    "setup:transcription": "bash scripts/setup/setup-transcription-engine.sh",
    "setup:ace-step": "bash scripts/setup/setup-ace-step-engine.sh",
    "setup:allin1-docker": "docker compose build allin1-worker",
    "allin1:docker": "bash scripts/pipelines/run-allin1-docker.sh",
    "ace-step:start": "bash scripts/services/start-ace-step-api.sh",
    "dev:web": "bash scripts/launchers/start-web-ui.sh",
    "dev:api": "bash scripts/launchers/start-ace-proxy-api.sh",
    "dev:ace": "bash scripts/launchers/start-ace-step-model-api.sh",
    "reference": "node scripts/pipelines/run-reference-pipeline.js",
    "sample:fast": "node scripts/pipelines/run-fast-sample.js",
    "sample:structured": "node scripts/pipelines/run-structured-sample.js",
    "reference:sweep": "node scripts/pipelines/run-reference-sweep.js",
    "yue:prepare": "node scripts/packaging/prepare-yue-test.js",
    "suno:prepare": "node scripts/packaging/prepare-suno-cover.js",
    "suno:proxy": "node scripts/packaging/prepare-suno-proxy.js",
    "suno:proxy-run": "node scripts/pipelines/run-suno-proxy-pipeline.js",
    "ace:ui": "node --env-file=.env scripts/dev/ace-proxy-ui.js",
    "web:dev": "concurrently -n api,vue -c cyan,green \"node --env-file=.env scripts/dev/ace-proxy-ui.js\" \"npm run dev --prefix web -- --host 127.0.0.1\"",
    "feedback": "node scripts/feedback/record-listen-feedback.js",
    "start": "node --env-file=.env backend/server.js",
    "test": "node --test backend/test/*.test.js",
    "setup:musicgen": "bash scripts/setup/setup-musicgen-engine.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
